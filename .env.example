# Required. Gemini qua endpoint OpenAI-compatible (config.py tự gửi key qua header x-goog-api-key nếu là Vertex).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aiplatform.googleapis.com/v1/projects/<project-id>/locations/global/endpoints/openapi
OPENAI_MODEL=google/gemini-3.5-flash-lite
# AI Studio thay thế:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash-lite

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
